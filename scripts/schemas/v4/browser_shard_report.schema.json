{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/v4/browser-shard-report.schema.json",
  "type": "object",
  "required": ["schema_version", "status", "replay_hash", "request_serialization_hash", "case_count", "manifest", "browser_document_observations", "coverage_summary", "failures"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["PASS", "FAIL"]},
    "replay_hash": {"type": "string", "minLength": 1},
    "request_serialization_hash": {"type": "string", "minLength": 1},
    "case_count": {"type": "integer", "minimum": 0},
    "shard_index": {"type": "integer", "minimum": 0},
    "shard_count": {"type": "integer", "minimum": 1},
    "manifest": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "browser_document_observations": {"type": "array", "items": {"type": "object", "required": ["id", "source_revision", "source_id", "canonical_text_sha256"]}},
    "coverage_summary": {"$ref": "coverage-summary.schema.json"},
    "failures": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["case_id", "document_id", "source_revision", "source_id", "subsection_id", "canonical_text_sha256", "rendered", "clicked", "supporting_content_count", "primary_source_count", "highlighted_text_sha256", "primary_source_identity"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "subsection_id": {"type": "string", "minLength": 1},
        "canonical_text_sha256": {"type": "string", "minLength": 1},
        "rendered": {"const": true},
        "clicked": {"const": true},
        "supporting_content_count": {"const": 1},
        "primary_source_count": {"const": 1},
        "highlighted_text_sha256": {"type": "string", "minLength": 1},
        "primary_source_identity": {"$ref": "primary-source-identity.schema.json"}
      }
    }
  }
}
